    <!-- http://www.hcs2I.com/WAx-framework-ontology#WAP_BO -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#WAP_BO">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasForm"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Explicit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#CSTS_primary_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#pertainsTo"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Blunt-end_operator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Work As Prescribed by the Blunt-end Operator (WAPBO).
Work As Prescribed (WAP) encompasses the available prescriptive aspects of work within the organization responsible for the process being investigated, usually following different degrees of formalization at task or job level (e.g.) procedures, checklists, standards, or job descriptions, prescriptive training. In the WAX ontology, WAP is also referred to WAP_BO (BO: Blunt-end Operator)</rdfs:isDefinedBy>
    </owl:Class>
    



    <!-- http://www.hcs2I.com/WAx-framework-ontology#WAP -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#WAP">
        <owl:equivalentClass rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAP_BO"/>
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>

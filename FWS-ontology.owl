    <!-- http://www.hcs2I.com/WAx-framework-ontology#Blunt-end_introspection -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Blunt-end_introspection">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Introspection"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasDriver"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAO_BO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_BO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The introspection activity performed by blunt-end operator.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Blunt-end_operator -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Blunt-end_operator">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent_role"/>
        <rdfs:isDefinedBy>The blunt-end role concerns the agent who has a stake in the system but does not operate directly on it (e.g., the production manager responsible for the production process).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#CSTS_analysis_knowledge -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#CSTS_analysis_knowledge">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Level"/>
        <rdfs:isDefinedBy>CSTS analysis knowledge is where knowledge of the CSTS is acquired, integrated, elaborated and used by an analyst to pursue an analysis of the system (e.g., safety-oriented, efficiency-oriented, or a combined one in line with Safety-II concepts (Hollnagel, 2012)).

REFERENCE
Hollnagel, E., 2012. FRAM: The Functional Resonance Analysis Method - Modelling Complex Socio-technical Systems. Ashgate.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#CSTS_primary_knowledge -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#CSTS_primary_knowledge">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Level"/>
        <rdfs:isDefinedBy>CSTS primary knowledge is where knowledge of the CST system is explicitly or tacitly created, shared, integrated and applied by blunt-end or sharp-end agents. Such knowledge includes organizational goals, rules, procedures, norms, beliefs, mental models, constraints, etc.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#CST_world -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#CST_world">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Level"/>
        <rdfs:isDefinedBy>CST world is where knowledge is actually used to achieve the CST functional purpose. It is the real world that can be considered as a space where system operations, performed by humans, organizations, technical and cyber artifacts take place. These operations are ultimately unobservable in their entirety, but reasonable estimation can be reached via direct observation by humans or indirect ones by technology (i.e., sensors or software).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Combination -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Combination">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity"/>
        <rdfs:isDefinedBy>Combination (Explicit-to-Explicit): the activity referred to the conversion of explicit knowledge into other variants of explicit knowledge.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Computational_agent -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Computational_agent">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent"/>
        <rdfs:isDefinedBy xml:lang="en">An agent that is the result of the act or action of computing.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Conceptualization -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Conceptualization">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasDriver"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_modelling_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAD"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Conceptualization (Action-to-Tacit): the activity related to the creation of tacit knowledge from aspects related to real work actions in the CST world.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Cyber-human_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Cyber-human_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Cyber_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Human_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A cyber-human system is a system that is viewed as consisting of only cyber artefacts and human agents (CH).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Cyber-physical-human_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Cyber-physical-human_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Cyber-socio-technical_system"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Cyber_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Human_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Physical_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A cyber-physical human system is a cyber-socio-technical system that is viewed as consisting of cyber artefacts, physical devices, and human agents (CPH).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Cyber-physical_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Cyber-physical_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Cyber_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Physical_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A cyber-physical system is a system that is viewed as consisting of only cyber artefacts and physical devices (CP). Modern technical systems are defined by both a cyber and a physical part. The former encompasses software systems, which nowadays are characterized by increasing autonomy and intelligence, while the latter includes traditional technical systems, hardware infrastructures, and other modern physical devices, such as sensors and actuators, that are conceived to interoperate with their cyber counter-part. Examples of cyber-physical systems are robots where both the cyber and physical aspects work jointly to achieve a functional goal.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Cyber-socio-technical_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Cyber-socio-technical_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Socio-technical_system"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Cyber_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Social_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Technical_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>A cyber-socio-technical system is a system that is viewed as consisting of cyber artefacts, physical devices, and human agents (CPH). Furthermore, the notion of cyber-socio-technical system allows to go even further. Differently from the traditional notion of socio-technical systems, in light of the cyber artefacts’ increased autonomy and intelligence, the analysis of cyber-socio-technical system extends towards the “social” relationships between humans and cyber artefacts, as well as multiple cyber artefacts that act jointly.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Cyber_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Cyber_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Technical_system"/>
        <rdfs:isDefinedBy xml:lang="en">A cyber system is a system consisting of cyber artefacts (C).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Deliberative_knowledge_conversion_driver -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Deliberative_knowledge_conversion_driver">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_conversion_driver"/>
        <rdfs:isDefinedBy>Deliberative drivers can be classified via a set of ETTO drivers representing the motivating factor connected to a deliberative knowledge conversion due to ETTO (Efficiency-Thoroughness Trade-Off) principle (Hollnagel, 2009). An ETTO-driven conversion is always originated by the willingness of a subjective contribution in knowledge conversion.

REFERENCE
Hollnagel, E., 2009. The ETTO principle: Efficiency-thoroughness trade-off: Why things that go right sometimes go wrong, Ashgate Publishing Ltd.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Deliberative_knowledge_conversion_driver"/>
        <rdfs:isDefinedBy>The ETTO communication driver represents the motivating factor connected to a ETTO deliberative knowledge conversion driven by specific communication goals, or affected by the expectation on the knowledge conversion (e.g. hiding parts of the process not compliant with the existing laws and regulations, deliberatively provide more or less details on some aspects).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#ETTO_modelling_driver -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#ETTO_modelling_driver">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Deliberative_knowledge_conversion_driver"/>
        <rdfs:isDefinedBy>The ETTO modelling driver represents the ETTO motivating factor caused by specific modelling choices (e.g., decision of a modelling perspective and/or formalism, selection of a modelling formalism, use of modelling best practices, selection of a model abstraction level). One example could be the adoption of the Functional Resonance Analysis Method (FRAM) (Patriarca et al., 2020) instead of the Business Process Model and Notation (BPMN). This is a deliberative modelling choice specifically helpful when dealing with safety-related issues in socio-technical systems. Similarly, an ETTO modelling driver could refer to the usage of tally counts for the occurrence of certain pre-identified behaviours during a naturalistic observation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Deliberative_knowledge_conversion_driver"/>
        <rdfs:isDefinedBy>The ETTO process driver represents the ETTO motivating factor necessary to achieve a well-defined objective in specific contextual conditions. This is dependent on the process being analysed (e.g. skipping a delayed formal authorization for process activation in a machine to ensure process execution).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Explicit_knowledge -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Explicit_knowledge">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_form"/>
        <rdfs:isDefinedBy xml:lang="en">Explicit or codified knowledge refers to knowledge that is transmittable in formal, systematic language.

References:
- Nonaka, I. (1994). A dynamic theory of organizational knowledge creation. Organization science, 5(1), 14-37.
- Polanyi, M. (1966), The Tacit Dimension, London: Routledge &amp; Kegan Paul.

Explicit knowledge (knowing-that): knowledge codified and digitized in books, documents, reports, memos, etc. Documented information that can facilitate action. Knowledge what is easily identified, articulated, shared and employed.

Reference:
https://www.tlu.ee/~sirvir/Information%20and%20Knowledge%20Management/Key_Concepts_of_IKM/tacit_and_explicit_knowledge.html</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Externalisation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Externalisation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Tacit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Explicit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Externalisation (Tacit-to-Explicit): this activity requires the expression of tacit knowledge and its translation into comprehensible forms interpretable by external agents.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#ProcessTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasDriver"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_conversion_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Foundational knowledge conversion activities allow knowledge conversion between two knowledge entities, as largely inspired by (Nonaka et al., 2000).

REFERENCE
Nonaka, I., Toyama, R., Konno, N., 2000. SECI, Ba and Leadership: A Unified Model of Dynamic Knowledge Creation. Long Range Plann. 33, 5–34.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Human -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Human">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Living_entity"/>
        <rdfs:isDefinedBy>A bipedal primate mammal (Homo sapiens): a person.

Reference:
Merriam-Webster (https://www.merriam-webster.com/dictionary/human)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Human_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Human_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Social_system"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Human"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A human system is a type of system that deals with human agents (H).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Internalisation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Internalisation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Explicit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Tacit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Internalisation (Explicit-to-Tacit): the activity related to the conversion of explicit knowledge into tacit knowledge.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Introspection -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Introspection">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Tacit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Tacit_knowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Introspection (Tacit-to-Tacit, same agent): the conscious or unconscious examination of one&apos;s own tacit knowledge, as taken at an individual level.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Knowledge_conversion_driver -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_conversion_driver">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#Proposition"/>
        <rdfs:isDefinedBy xml:lang="en">The explanatory factor connected to knowledge development, i.e. explain how it is converted.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#Procedure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasForm"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_form"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Level"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#pertainsTo"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#refersTo"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>The knowledge entities represent different knowledge dimensions, i.e. what knowledge is referred to.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Knowledge_form -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_form">
        <owl:equivalentClass rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_type"/>
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#InternalAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_structure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A characterization of knowledge.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Knowledge_structure -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_structure">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#Model"/>
        <rdfs:isDefinedBy>A conceptual artefact that is made of three constituent elements: (i) levels, representing where knowledge is located, (ii) knowledge types, i.e. in which form (how) knowledge is preserved and (iii) agency, i.e. the agent who is responsible for the knowledge.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Knowledge_type -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_type">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#InternalAttribute"/>
        <rdfs:isDefinedBy xml:lang="en">A characterization of knowledge.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_accessibility -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_accessibility">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not available, or easily and quickly retrievable.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_appropriate_amount_of_data -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_appropriate_amount_of_data">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:isDefinedBy xml:lang="en">The extent to which the volume of information is not appropriate for the task at hand

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_believability -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_believability">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not regarded as true and credible.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_completeness -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_completeness">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <SUMO:represents xml:lang="en">The extent to which information is missing and is not of sufficient breadth and depth for the task at hand.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</SUMO:represents>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_concise_representation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_concise_representation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_modelling_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not compactly represented.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_consistent_representation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_consistent_representation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not presented in the same format.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_ease_of_manipulation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_ease_of_manipulation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not easy to manipulate and apply to different tasks.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#InternalAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#isFeatureOf"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>A feature of a knowledge entity that describes the result of objective or subjective assessments on the lack of quality of its information content.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_interpretability -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_interpretability">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_modelling_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not in appropriate languages, symbols, and units, and the definitions are clear.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_objectivity -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_objectivity">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not unbiased, unprejudiced, and impartial.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_relevancy -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_relevancy">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not applicable and helpful for the task at hand.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_reputation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_reputation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not highly regarded in terms of its source or content.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_security -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_security">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which access to information is not restricted appropriately to maintain its security.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_timeliness -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_timeliness">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not sufficiently up-to-date for the task at hand.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_understandability -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_understandability">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_modelling_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not easily comprehended.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Lack_of_value-added -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_value-added">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not beneficial and does not provide advantages from its use.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Level -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Level">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#InternalAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Knowledge_structure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>The levels are part of the knowledge structure and represent where knowledge is located.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Living_entity -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Living_entity">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent"/>
        <rdfs:isDefinedBy xml:lang="en">An agent that is an individual life form considered as an entity (e.g. an animal or a person).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Not_free-of-error -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Not_free-of-error">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Lack_of_information_quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#motivates"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The extent to which information is not correct and reliable.

Reference:
L. L. Pipino, Y. W. Lee, R. Y. Wang, Data quality assessment, Communications of the ACM 45 (4) (2002) 211–218.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Physical-human_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Physical-human_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Socio-technical_system"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Human_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Physical_system"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A physical-human system is a system that is viewed as consisting of only physical devices and human agents (PH).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Physical_object -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Physical_object">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Subsystem"/>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Physical_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Physical_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Technical_system"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Physical_object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A physical system is a system that deals with physical devices (P). Traditional technical systems include physical devices, infrastructures, and machines (e.g. lathes, milling machines), which are used to support human activities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Process -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Process">
        <rdfs:subClassOf rdf:resource="file:/Users/antoniodenicola/Library/CloudStorage/GoogleDrive-antonio.denicola@gmail.com/Il%20mio%20Drive/MGM/CONFERENZE-Workshops-Chapters/2026-EMMSAD/Ontology/SUMO.owl#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#isProcessOf"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A series of actions or operations conducing to an end.

References
https://www.merriam-webster.com/dictionary/process</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Reification -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Reification">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Foundational_knowledge_conversion_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasDriver"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_process_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_SO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAD"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Reification (Tacit-to-Action): is the activity of bringing tacit knowledge into action (e.g. translating a mental model of a process activity into the actual operating tasks).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Robot -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Robot">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent"/>
        <rdfs:isDefinedBy xml:lang="en">A machine that resembles a living creature in being capable of moving independently (as by walking or rolling on wheels) and performing complex actions (such as grasping and moving objects).

A device that automatically performs complicated, often repetitive tasks (as in an industrial assembly line)

Reference:
Merriam-Webster (https://www.merriam-webster.com/dictionary/robot)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Robot_system -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Robot_system">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Cyber_system"/>
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Social_system"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/FWS-ontology#hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Robot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>A type of system that consists of robots.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Sharp-end_Conceptualization -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Sharp-end_Conceptualization">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Conceptualization"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_SO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The conceptualization activity performed by sharp-end operator.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Sharp-end_externalisation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Sharp-end_externalisation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Externalisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasDriver"/>

                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent_role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">One that acts.

Reference:
https://www.merriam-webster.com/dictionary/agent</rdfs:isDefinedBy>
    </owl:Class>
    



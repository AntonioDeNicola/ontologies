                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WADI_SO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_Analyst-of-WAI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_BO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The externalsation activity performed by sharp-end operator.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.hcs2I.com/WAx-framework-ontology#Sharp-end_internalisation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Sharp-end_internalisation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Internalisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_SO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The internalisation activity performed by sharp-end operator.</rdfs:isDefinedBy>
    </owl:Class>
    



    <!-- http://www.hcs2I.com/WAx-framework-ontology#Analyst_internalisation_for_WAI_of_WAI_creation -->

    <owl:Class rdf:about="http://www.hcs2I.com/WAx-framework-ontology#Analyst_internalisation_for_WAI_of_WAI_creation">
        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Analyst_internalisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasDriver"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#ETTO_communication_driver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WADI_BO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAN"/>
            </owl:Restriction>
        </rdfs:subClassOf>

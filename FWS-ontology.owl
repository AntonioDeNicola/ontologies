        <rdfs:subClassOf rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Subsystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasAggregationLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#Agent_aggregation_level"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>

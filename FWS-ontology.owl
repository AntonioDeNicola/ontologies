            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_SO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>

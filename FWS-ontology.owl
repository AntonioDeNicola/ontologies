            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The internalisation activity performed by the blunt-end operator to create the WAI_BO from WAN and WAP_BO.</rdfs:isDefinedBy>
    </owl:Class>
    



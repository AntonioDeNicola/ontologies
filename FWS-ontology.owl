                <owl:someValuesFrom rdf:resource="http://www.hcs2I.com/WAx-framework-ontology#WAI_Analyst-of-WAI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">The internalisation activity performed by analyst to create the WAI_Analyst_of_WAI from WADI_BO, WAN, and WAP_BO.</rdfs:isDefinedBy>
    </owl:Class>
    



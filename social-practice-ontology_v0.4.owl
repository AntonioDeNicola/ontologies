     -->

    <rdf:Description rdf:about="https://www.enea.it/social-practice-ontology_v0.4#Meaning_hasMeaningContent_min1">
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:about="https://www.enea.it/social-practice-ontology_v0.4#Meaning_hasMeaningType_min1">
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
</rdf:RDF>



